{
  "name": "cloudhopper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "node tests/run.mjs",
    "preview": "vite preview --host",
    "icons": "node scripts/icons.mjs",
    "animals": "node scripts/animals.mjs",
    "words": "node scripts/letterwords.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "sheet": "node scripts/picturesheet.mjs",
    "audit": "node scripts/audit.mjs",
    "contact": "node scripts/contact.mjs",
    "voice": "node scripts/voice.mjs",
    "voicecheck": "node scripts/voicecheck.mjs",
    "sfx": "node scripts/sfx.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@fontsource/nunito": "^5.1.0"
  }
}
